    <!-- ========================================== -->

    <!-- ========================================== -->
    <!-- CHANGESET 1: Create extensions             -->
    <!-- ========================================== -->
    <changeSet id="C001" author="CIOC">
        <comment>Create necessary extensions</comment>
        <sql>
            CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
        </sql>
    </changeSet>

    <!-- ========================================== -->
    <!-- CHANGESET 2: Create Roles Table            -->
    <!-- ========================================== -->
    <changeSet id="C002" author="CIOC">
        <comment>Create roles table</comment>
        <createTable tableName="roles">
            <column name="role_id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(25)">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(25)"/>
            <column name="is_active" type="BOOLEAN" defaultValue="true"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <column name="created_by" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="UUID"/>
        </createTable>

        <rollback>
            <dropTable tableName="roles"/>
        </rollback>
    </changeSet>

    <!-- ========================================== -->
    <!-- CHANGESET 3: Create Users Table            -->
    <!-- ========================================== -->
    <changeSet id="C003" author="CIOC">
        <comment>Create users table</comment>
        <createTable tableName="users">
            <column name="user_id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="is_active" type="BOOLEAN" defaultValue="true"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <column name="created_by" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="UUID"/>
        </createTable>

        <addForeignKeyConstraint 
            baseTableName="users"
            baseColumnNames="role_id"
            referencedTableName="roles"
            referencedColumnNames="role_id"
            constraintName="fk_users_role_id"
            onDelete="RESTRICT"
            onUpdate="NO ACTION"/>

        <createIndex indexName="idx_users_email" tableName="users">
            <column name="email"/>
        </createIndex>

        <createIndex indexName="idx_users_role" tableName="users">
            <column name="role_id"/>
        </createIndex>

        <createIndex indexName="idx_users_active" tableName="users">
            <column name="is_active"/>
        </createIndex>

        <rollback>
            <dropTable tableName="users"/>
        </rollback>
    </changeSet>

