            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="UUID"/>
        </createTable>

        <createIndex indexName="idx_clients_personal_phone" tableName="clients">
            <column name="personal_phone"/>
        </createIndex>

        <createIndex indexName="idx_clients_contact_phone" tableName="clients">
            <column name="contact_phone"/>
        </createIndex>

        <createIndex indexName="idx_clients_full_name" tableName="clients">
            <column name="full_name"/>
        </createIndex>

        <createIndex indexName="idx_clients_email" tableName="clients">
            <column name="email"/>
        </createIndex>

        <rollback>
            <dropTable tableName="clients"/>
        </rollback>
    </changeSet>

