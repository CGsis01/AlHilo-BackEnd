    <!-- ========================================== -->
    <!-- CHANGESET 7: Create Repairs Table          -->
    <!-- ========================================== -->
    <changeSet id="C007" author="CIOC">
        <comment>Create repairs table</comment>
        <createTable tableName="repairs">
            <column name="repair_id" type="UUID" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_phone" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="customer_email" type="VARCHAR(255)"/>
            <column name="client_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="repair_status_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="estimated_price" type="DECIMAL(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="advance_payment" type="DECIMAL(10,2)"/>
            <column name="final_price" type="DECIMAL(10,2)"/>
            <column name="assigned_to_id" type="UUID"/>
            <column name="received_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="estimated_delivery_date" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="actual_delivery_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="notes" type="TEXT"/>
            <column name="is_express" type="BOOLEAN" defaultValue="false"/>
            <column name="is_active" type="BOOLEAN" defaultValue="true"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <column name="created_by" type="UUID"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()"/>
            <column name="updated_by" type="UUID"/>
        </createTable>

        <addForeignKeyConstraint 
            baseTableName="repairs"
            baseColumnNames="client_id"
            referencedTableName="clients"
            referencedColumnNames="client_id"
            constraintName="fk_repairs_client_id"
            onDelete="RESTRICT"
            onUpdate="NO ACTION"/>        

        <addForeignKeyConstraint 
            baseTableName="repairs"
            baseColumnNames="repair_status_id"
            referencedTableName="repair_status"
            referencedColumnNames="repair_status_id"
            constraintName="fk_repairs_repair_status_id"
            onDelete="RESTRICT"
            onUpdate="NO ACTION"/>

        <addForeignKeyConstraint 
            baseTableName="repairs"
            baseColumnNames="assigned_to_id"
            referencedTableName="users"
            referencedColumnNames="user_id"
            constraintName="fk_repairs_assigned_to_id"
            onDelete="RESTRICT"
            onUpdate="NO ACTION"/>

        <sql>
            ALTER TABLE repairs ADD CONSTRAINT chk_repairs_estimated_price CHECK (estimated_price >= 0);
        </sql>

        <sql>
            ALTER TABLE repairs ADD CONSTRAINT chk_repairs_final_price CHECK (final_price IS NULL OR final_price >= 0);
        </sql>

        <createIndex indexName="idx_repairs_status" tableName="repairs">
            <column name="repair_status_id"/>
        </createIndex>

        <createIndex indexName="idx_repairs_customer_phone" tableName="repairs">
            <column name="customer_phone"/>
        </createIndex>

        <createIndex indexName="idx_repairs_client_id" tableName="repairs">
            <column name="client_id"/>
        </createIndex>

        <createIndex indexName="idx_repairs_assigned_to" tableName="repairs">
            <column name="assigned_to_id"/>
        </createIndex>

        <createIndex indexName="idx_repairs_received_date" tableName="repairs">
            <column name="received_date"/>
        </createIndex>

        <createIndex indexName="idx_repairs_estimated_delivery" tableName="repairs">
            <column name="estimated_delivery_date"/>
        </createIndex>

        <rollback>
            <dropTable tableName="repairs"/>
        </rollback>
    </changeSet>

